<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hub_background">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hub_header"
        android:paddingTop="44dp"
        android:paddingBottom="18dp"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/backBtn"
            android:layout_centerVertical="true"
            android:text="Add New Task"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/hub_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/hub_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Task Title Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TASK TITLE"
                        android:textColor="@color/hub_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.08" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SchoolHub.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <EditText
                            android:id="@+id/taskTitleInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter task title"
                            android:inputType="text"
                            android:minHeight="56dp"
                            android:textSize="15sp"
                            android:textColor="@color/hub_text_primary"
                            android:textColorHint="@color/hub_text_secondary" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Description Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESCRIPTION (OPTIONAL)"
                        android:textColor="@color/hub_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.08" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SchoolHub.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <EditText
                            android:id="@+id/taskDescriptionInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Add task description"
                            android:inputType="textMultiLine"
                            android:minLines="4"
                            android:minHeight="120dp"
                            android:textSize="15sp"
                            android:textColor="@color/hub_text_primary"
                            android:textColorHint="@color/hub_text_secondary"
                            android:gravity="top" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Due Date Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DUE DATE &amp; TIME"
                        android:textColor="@color/hub_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/SchoolHub.TextInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp">

                            <EditText
                                android:id="@+id/taskDueDateInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select date &amp; time"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="text"
                                android:minHeight="56dp"
                                android:textSize="15sp"
                                android:textColor="@color/hub_text_primary"
                                android:textColorHint="@color/hub_text_secondary" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selectDateBtn"
                            style="@style/SchoolHub.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:minWidth="100dp"
                            android:text="Pick" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="end"
        android:background="@color/hub_surface"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelTaskBtn"
            style="@style/SchoolHub.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveTaskBtn"
            style="@style/SchoolHub.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save" />

    </LinearLayout>

</LinearLayout>

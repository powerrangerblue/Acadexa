<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="@color/textPrimary"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/backBtn"
            android:layout_centerVertical="true"
            android:text="Add Schedule"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cardStroke" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Subject Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Name"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.01" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:boxBackgroundMode="outline"
                app:hintAnimationEnabled="true"
                app:boxStrokeColor="@color/cardStroke"
                app:boxStrokeWidthFocused="2dp">

                <EditText
                    android:id="@+id/subjectInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter subject name"
                    android:inputType="text"
                    android:minHeight="56dp"
                    android:textSize="16sp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Day of Week Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day of Week"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.01" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/cardStroke"
                app:boxStrokeWidthFocused="2dp">

                <Spinner
                    android:id="@+id/daySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Start Time Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Time"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.01" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    app:boxBackgroundMode="outline"
                    app:hintAnimationEnabled="true"
                    app:boxStrokeColor="@color/cardStroke"
                    app:boxStrokeWidthFocused="2dp">

                    <EditText
                        android:id="@+id/startTimeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="HH:mm"
                        android:inputType="time"
                        android:minHeight="56dp"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectStartTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:minWidth="110dp"
                    android:text="Pick"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

            <!-- End Time Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Time"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.01" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    app:boxBackgroundMode="outline"
                    app:hintAnimationEnabled="true"
                    app:boxStrokeColor="@color/cardStroke"
                    app:boxStrokeWidthFocused="2dp">

                    <EditText
                        android:id="@+id/endTimeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="HH:mm"
                        android:inputType="time"
                        android:minHeight="56dp"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectEndTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:minWidth="110dp"
                    android:text="Pick"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="end"
        android:spacing="12dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelScheduleBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Cancel"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveScheduleBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Save"
            android:textSize="14sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>
